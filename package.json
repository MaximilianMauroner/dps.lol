{
  "name": "rift-delta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "benchmark:optimizer": "bun scripts/benchmark-optimizer.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "bun scripts/migrate.ts",
    "data:sync": "bun scripts/sync-static.ts",
    "archive:reconcile": "bun scripts/reconcile-archive.ts",
    "archive:rebuild": "bun scripts/rebuild-from-archives.ts",
    "archive:verify-rebuild": "bun scripts/verify-archive-rebuild.ts",
    "storage:audit": "bun scripts/storage-audit.ts",
    "storage:status": "bun scripts/storage-status.ts",
    "ingest:euw": "bun scripts/ingest.ts --region EUW1 --routing EUROPE --tiers CHALLENGER,GRANDMASTER,MASTER",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@types/pg": "^8.15.5",
    "next": "^15.5.3",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/bun": "latest",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.3",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
